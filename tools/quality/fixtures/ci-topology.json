{
  "schema_version": 1,
  "source_commit": "57ef195",
  "source_workflow_blob": "5e8ba056ccf7a4d19680bd8dcd4b42e478401ec3",
  "workflow": "CI",
  "branches": [
    "main"
  ],
  "events": [
    "pull_request",
    "push"
  ],
  "aggregate_job": "quality-required",
  "jobs": {
    "test": {
      "name": "Test",
      "check_names": [
        "Test"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "Full locked Linux nextest suite; exported schema must match committed schema.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' && needs.classify.outputs.reuse_verified != 'true' }}"
    },
    "test-cross-platform": {
      "name": "Test (${{ matrix.os }})",
      "check_names": [
        "Test (macos-latest)",
        "Test (windows-latest)"
      ],
      "runner_labels": [
        "macos-latest",
        "windows-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "Full locked native macOS and Windows nextest suites with --no-fail-fast; both PR-required.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' && needs.classify.outputs.run_native != 'false' && needs.classify.outputs.reuse_verified != 'true' }}"
    },
    "security-audit": {
      "name": "Security Audit",
      "check_names": [
        "Security Audit"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "cargo audit --deny warnings; installation errors block.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' }}"
    },
    "fmt": {
      "name": "Format",
      "check_names": [
        "Format"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "cargo fmt --check.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' }}"
    },
    "clippy": {
      "name": "Clippy",
      "check_names": [
        "Clippy"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "Locked all-targets/all-features Clippy with warnings denied.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' }}"
    },
    "build": {
      "name": "Build",
      "check_names": [
        "Build"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "Locked Linux release build; artifact absence retains existing ignore policy.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' }}"
    },
    "build-cross-platform": {
      "name": "Build (${{ matrix.os }})",
      "check_names": [
        "Build (macos-latest)",
        "Build (windows-latest)"
      ],
      "runner_labels": [
        "macos-latest",
        "windows-latest"
      ],
      "events": [
        "push"
      ],
      "required_events": [
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "Locked native macOS and Windows release builds.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' && needs.classify.outputs.run_native != 'false' && github.event_name != 'pull_request' }}"
    },
    "quality-fast": {
      "name": "Quality Fast Stages (legacy, production)",
      "check_names": [
        "Quality Fast Stages (legacy, production)"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [],
      "needs": [
        "classify"
      ],
      "outcome": "Legacy and production coverage shard; not required directly, feeds the merge job.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' && needs.classify.outputs.run_evidence != 'false' && needs.classify.outputs.reuse_verified != 'true' }}"
    },
    "quality-risk": {
      "name": "Quality Risk Stage (${{ matrix.side }}, shard ${{ matrix.shard }}/2)",
      "check_names": [
        "Quality Risk Stage (base, shard 1/2)",
        "Quality Risk Stage (base, shard 2/2)",
        "Quality Risk Stage (head, shard 1/2)",
        "Quality Risk Stage (head, shard 2/2)"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [],
      "needs": [
        "classify"
      ],
      "outcome": "Base/head risk test partitions on independent hosted runners; the merge job validates every shard, merges LLVM-derived coverage/risk evidence, compares both sides and assembles the risk shard.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' && needs.classify.outputs.run_evidence != 'false' && needs.classify.outputs.reuse_verified != 'true' }}"
    },
    "quality-matrix": {
      "name": "Quality Matrix Stage",
      "check_names": [
        "Quality Matrix Stage"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [],
      "needs": [
        "classify"
      ],
      "outcome": "Isolated critical-path matrix shard; not required directly, feeds the merge job.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' && needs.classify.outputs.run_evidence != 'false' && needs.classify.outputs.reuse_verified != 'true' }}"
    },
    "quality-coverage": {
      "name": "Quality Coverage and Critical Paths",
      "check_names": [
        "Quality Coverage and Critical Paths"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify",
        "quality-fast",
        "quality-risk",
        "quality-matrix"
      ],
      "outcome": "Merge the fast, risk and matrix shard candidates, require the complete four-stage evidence set, verify hashes, and always retain the sealed candidate.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' && needs.classify.outputs.run_evidence != 'false' && needs.classify.outputs.reuse_verified != 'true' }}"
    },
    "quality-generic-shadow": {
      "name": "Generic Quality Shadow",
      "check_names": [
        "Generic Quality Shadow"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [],
      "needs": [
        "classify",
        "quality-coverage"
      ],
      "outcome": "Advisory projection of retained candidate with identity/hash validation; no aggregate dependency or release authority.",
      "condition": "${{ always() && needs.classify.outputs.run_full == 'true' && needs.classify.outputs.run_evidence != 'false' && needs.classify.outputs.reuse_verified != 'true' }}"
    },
    "quality-contracts": {
      "name": "Quality CLI Contracts",
      "check_names": [
        "Quality CLI Contracts"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "Linux CLI contract snapshots, exit codes and output evidence.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' }}"
    },
    "quality-contracts-cross-platform": {
      "name": "Quality CLI Contracts (${{ matrix.os }})",
      "check_names": [
        "Quality CLI Contracts (macos-latest)",
        "Quality CLI Contracts (windows-latest)"
      ],
      "runner_labels": [
        "macos-latest",
        "windows-latest"
      ],
      "events": [
        "push"
      ],
      "required_events": [
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "Native macOS/Windows structured CLI contracts.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' && needs.classify.outputs.run_native != 'false' && github.event_name != 'pull_request' }}"
    },
    "docs-consistency": {
      "name": "Documentation Consistency",
      "check_names": [
        "Documentation Consistency"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "Documentation/examples/presets/migration/schema/policy-anchor/link/sandbox consistency."
    },
    "release-contracts": {
      "name": "Release Governance Contracts",
      "check_names": [
        "Release Governance Contracts"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "Release governance unit tests and compile checks; publication authority unchanged.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' }}"
    },
    "quality-scripts": {
      "name": "Quality Script Tests",
      "check_names": [
        "Quality Script Tests"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [
        "pull_request",
        "push"
      ],
      "needs": [
        "classify"
      ],
      "outcome": "All quality Python unit tests and compile checks.",
      "condition": "${{ needs.classify.outputs.run_full == 'true' }}"
    },
    "quality-required": {
      "name": "Required Quality Aggregate",
      "check_names": [
        "Required Quality Aggregate"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [],
      "needs": [
        "classify",
        "test",
        "test-cross-platform",
        "security-audit",
        "fmt",
        "clippy",
        "build",
        "build-cross-platform",
        "quality-coverage",
        "quality-contracts",
        "quality-contracts-cross-platform",
        "docs-consistency",
        "release-contracts",
        "quality-scripts"
      ],
      "outcome": "Evaluate all dependencies; explicit impact deferral or verified inheritance may skip only selected jobs. Missing, failed or cancelled dependencies block.",
      "condition": "${{ always() }}"
    },
    "classify": {
      "name": "Classify change",
      "check_names": [
        "Classify change"
      ],
      "runner_labels": [
        "ubuntu-latest"
      ],
      "events": [
        "pull_request",
        "push"
      ],
      "required_events": [],
      "aggregate_required": true,
      "needs": [],
      "outcome": "Pure-docs vs full selection from changed paths; conservative for unknown or empty scope."
    }
  },
  "observed_pre_change_aggregate_gap": "test-cross-platform ran on both events but was mistakenly in ci_quality.PUSH_ONLY. GH-164 enforces the already specified PR requirement; no scheduling change.",
  "cadence_amendment": "docs/engineering-policy.md#ci-cadence-amendment",
  "inheritance_amendment": "docs/engineering-policy.md#equivalent-main-push-check-inheritance",
  "impact_amendment": "docs/engineering-policy.md#impact-routed-pr-and-main-checks",
  "full_validation_events": [
    "schedule",
    "workflow_dispatch"
  ]
}
