    "test_rust_collector_delivery": "Retain legacy immutable delivery identity, wrong-Core-bytes-before-execution, pinned JSON/symlink rejection and relocation contracts; external-toolchain acceptance is not a complete replacement.",
    "test_rust_collector_runtime": "Retain paused bundled-runtime build-input and installed-schema-layout checks. Private-runtime tests and GateProbes external-toolchain RC8 acceptance cover distinct products.",
    "test_rust_native": "Retain the bounded legacy rust_native.py MIR experiment and its compiler-specific replay/inventory tests; GateProbes migrated the driver implementation, not this experiment.",
    "test_typescript_acceptance": "Retain historical Angular/V8 native windows, exact counters, Git/source receipts and debt/series acceptance. GateProbes original-source instrumentation is a different measurement boundary.",
    "test_typescript_advisory": "Retain Core frontend-advisory failure records, artifact inventory and historical archive integrity checks; that workflow and reference tooling are not migrated.",
    "test_typescript_contracts": "Retain gh-133 historical Python contract adapter, relationship outcome and generic policy/provenance checks; current HTTP plugin CLI/schema acceptance does not replace that retained window.",
    "test_typescript_policy": "Retain generic policy/debt/history reference tests, including mixed Rust/TypeScript historical series; these exercise Core decisions.",
    "test_typescript_reference": "Retain the historical Angular/V8 archive adapter, transport and unsupported-CRAP contracts. GateProbes typescript-risk explicitly excludes mapped Angular/V8 reports and supports a different original-source series.",
    "test_typescript_semantics": "Retain historical archive/parser/receipt joins, source-map and UTF-16 integrity, unavailable metrics and measurement-series compatibility tests; these are outside the migrated TypeScript plugin scope."
