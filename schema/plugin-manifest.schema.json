{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "harness-plugin/v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 64
    },
    "core_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
        "maxLength": 64
      },
      "minItems": 1
    },
    "protocol": {
      "const": "harness-preset-catalog/v1"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "presets": {
      "type": "string",
      "minLength": 1
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,128}$"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
        "maxLength": 64
      }
    }
  },
  "required": [
    "schema",
    "name",
    "source",
    "version",
    "core_versions",
    "protocol",
    "platforms",
    "files",
    "presets",
    "programs",
    "dependencies"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/musutrade/GateHouse/schema/plugin-manifest.schema.json"
}
