{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "harness-plugin-lock/v1"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "maxLength": 64
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "signer": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "source",
          "version",
          "manifest_sha256",
          "signer"
        ]
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "schema",
    "plugins"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/musutrade/GateHouse/schema/plugin-lock.schema.json"
}
